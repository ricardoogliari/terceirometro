#!/usr/bin/env bash

# Cores para feedback visual no terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # Sem cor

echo -e "\n${BLUE}🔍 [Pre-commit Hook] Iniciando validações de qualidade do código...${NC}\n"

# ------------------------------------------------------------------------------
# 1. Validação de Formatação (dart format)
# ------------------------------------------------------------------------------
echo -e "${BLUE}▶ [1/3] Verificando formatação do código (dart format)...${NC}"

# --set-exit-if-changed retorna código 1 se algum arquivo não estiver formatado
dart format --output=none --set-exit-if-changed .

if [ $? -ne 0 ]; then
  echo -e "\n${RED}❌ Erro de formatação detectado!${NC}"
  echo -e "${YELLOW}💡 Dica: Execute 'dart format .' e adicione os arquivos novamente com 'git add'.${NC}\n"
  exit 1
fi
echo -e "${GREEN}✔ Formatação válida.${NC}"

# ------------------------------------------------------------------------------
# 2. Análise Estática Estrita (flutter analyze)
# ------------------------------------------------------------------------------
echo -e "\n${BLUE}▶ [2/3] Executando análise estática (flutter analyze)...${NC}"

flutter analyze

if [ $? -ne 0 ]; then
  echo -e "\n${RED}❌ O analisador estático encontrou erros ou violações de lint!${NC}"
  echo -e "${YELLOW}💡 Dica: Corrija os avisos do 'analysis_options.yaml' antes de commitar.${NC}\n"
  exit 1
fi
echo -e "${GREEN}✔ Análise estática aprovada (zero warnings/erros).${NC}"

# ------------------------------------------------------------------------------
# 3. Verificaçao de complexidade de código
# ------------------------------------------------------------------------------
#echo -e "\n${BLUE}▶ Verificando complexidade do código (dart_code_linter)...${NC}"
#dart run dart_code_linter:metrics analyze . --set-exit-on-violation-level=warning
#if [ $? -ne 0 ]; then
#  echo -e "\n${RED}❌ Violação de complexidade ou aninhamento excessivo detectada!${NC}"
#  echo -e "${YELLOW}💡 Dica: Reduza o aninhamento de loops/ifs ou divida a função em partes menores.${NC}\n"
#  exit 1
#fi
#  echo -e "${GREEN}✔ Métricas de complexidade aprovadas.${NC}"

# ------------------------------------------------------------------------------
# 5. Execução de Testes Unitários Rápidos (flutter test)
# ------------------------------------------------------------------------------
echo -e "\n${BLUE}▶ [3/3] Executando testes unitários (flutter test)...${NC}"

# Verifica se existe a pasta test/ com testes antes de rodar
if [ -d "test" ] && [ "$(ls -A test)" ]; then
  flutter test
  if [ $? -ne 0 ]; then
    echo -e "\n${RED}❌ Alguns testes unitários falharam!${NC}\n"
    exit 1
  fi
  echo -e "${GREEN}✔ Todos os testes passaram com sucesso.${NC}"
else
  echo -e "${YELLOW}⚠ Nenhum arquivo de teste encontrado em test/. Pulando etapa de testes.${NC}"
fi

echo -e "\n${GREEN}✨ Todas as verificações passaram! Commit permitido.${NC}\n"
exit 0